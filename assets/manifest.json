{
  "$comment": "Single source of truth for every generated asset. See BUILD_PROMPT.md \u00a79.5. Specs are authored BEFORE generation; status flips as each is produced. Resumable: generate the next 'todo'.",
  "styleBible": "STYLE: hand-inked fantasy manuscript illustration. Dark desaturated palette - charcoal black, aged parchment cream, oxidised copper, muted blood red, one antique-gold accent. Visible pen hatching and ink-wash shading. Matte, no gloss, no lens flare, no neon. Slight paper grain. Composition centred and uncluttered. No text, no lettering, no borders, no watermark, no signature.",
  "styleBibleVersion": "1.0.0",
  "styleBibleNotes": "Validated 2026-11-02 and used unchanged across all 11 generation sheets. Do not revise without re-piloting; library consistency depends on this string being stable.",
  "generation": {
    "source": "chat.com (user's own account), driven via Chrome MCP",
    "requestFormat": "'Generate one image. ' + styleBible + ' SUBJECT: ' + subjectPrompt + ' ' + framing + ' ' + aspectClause",
    "variants": "Provider returns 2 variants; pick one, record which in sourceNote. Decline the A/B preference prompt via Skip rather than submitting a rating.",
    "download": "Open the image lightbox, use its download button (NOT the share arrow \u2014 that offers public links). Allow ~30s; the file lands in ~/Downloads.",
    "cutout": "For transparent:true specs, use the lightbox 'Remove BG' tool before downloading \u2014 better than post-hoc keying on inked art.",
    "postProcess": "scripts/process-asset.sh <raw> <basename> <category>",
    "contactSheets": "Assets are generated SIX-PER-REQUEST as a 3x2 contact sheet (or two-per-request as stacked wide panels for biomes), then cut apart by scripts/slice-sheet.py / slice-biomes.sh. This is ~6x fewer round-trips AND enforces style consistency, because the model paints the whole set in one pass. Portrait crops are biased upward (--bias 0.06): faces sit high in a 2:3 cell and a centred square crop decapitates them."
  },
  "categories": {
    "portraits": {
      "size": "512x512 + 128 thumb",
      "budgetKB": 60,
      "purpose": "Runtime tag-matched to AI companions and NPCs; see BUILD_PROMPT.md \u00a79.5"
    },
    "creatures": {
      "size": "512x512 + 128 thumb",
      "budgetKB": 60,
      "purpose": "Common low-CR SRD bestiary art for the initiative tracker and encounter cards"
    },
    "biomes": {
      "size": "1280x720 + 320 thumb",
      "budgetKB": 180,
      "purpose": "Scene-card backdrops, selected by location tags"
    },
    "textures": {
      "size": "512x512 seamless",
      "budgetKB": 40,
      "purpose": "Parchment/leather surfaces for panels"
    },
    "frames": {
      "size": "256x256",
      "budgetKB": 40,
      "purpose": "Loot card frames by rarity"
    },
    "brand": {
      "size": "1200x630",
      "budgetKB": 40,
      "purpose": "Title backdrop, OG image, favicon source"
    }
  },
  "matcher": {
    "$comment": "How the runtime picks a portrait for a generated companion/NPC. No image model on-device, so selection replaces generation.",
    "scoreFields": [
      "species",
      "archetype",
      "build",
      "age",
      "mood"
    ],
    "weights": {
      "species": 3,
      "archetype": 2,
      "build": 1,
      "age": 1,
      "mood": 1
    },
    "fallback": "procedural seeded SVG sigil when best score < 5",
    "rerollable": true
  },
